<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AlphaChannel.TexTools.UI.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <SolidColorBrush x:Key="TtAccentBrush" Color="#119EDA" />
    <SolidColorBrush x:Key="TtAccentDarkBrush" Color="#0B7FB3" />
    <SolidColorBrush x:Key="TtChromeBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TtPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TtBorderBrush" Color="#CCD3D9" />
    <SolidColorBrush x:Key="TtMutedBrush" Color="#5A6570" />
    <SolidColorBrush x:Key="TtTextBrush" Color="#1A1F24" />
    <SolidColorBrush x:Key="TtStatusBrush" Color="#E8EEF2" />
    <SolidColorBrush x:Key="TtMenuBrush" Color="#FAFBFC" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.tt-group">
      <Setter Property="Background" Value="{StaticResource TtPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource TtBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{StaticResource TtAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource TtAccentDarkBrush}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource TtAccentDarkBrush}" />
    </Style>
    <Style Selector="Menu">
      <Setter Property="Background" Value="{StaticResource TtMenuBrush}" />
    </Style>
  </Application.Styles>
</Application>
