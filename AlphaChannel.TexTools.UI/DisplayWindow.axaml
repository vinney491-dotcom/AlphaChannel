<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AlphaChannel.TexTools.UI"
        x:Class="AlphaChannel.TexTools.UI.DisplayWindow"
        Title="Item Viewer"
        Width="1000" Height="640"
        MinWidth="640" MinHeight="400"
        Background="{StaticResource TtChromeBrush}"
        WindowStartupLocation="CenterOwner">
  <local:DisplayPanel Name="Panel" />
</Window>
