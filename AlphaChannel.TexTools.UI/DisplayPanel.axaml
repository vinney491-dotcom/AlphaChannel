<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AlphaChannel.TexTools.UI.DisplayPanel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource TtAccentBrush}" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="TitleText" Text="Display" Foreground="White" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Name="PopOutButton" Content="Pop Out" Click="OnPopOut" Padding="8,2" />
          <Button Name="ExportButton" Content="Export…" Click="OnExport" Padding="8,2" IsEnabled="False" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource TtStatusBrush}"
            BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="InfoText" Text="Select a file to preview." Foreground="{StaticResource TtMutedBrush}"
                   TextWrapping="Wrap" FontSize="11" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Name="ChannelPanel" IsVisible="False">
          <CheckBox Name="RedBox" Content="R" IsChecked="True" IsCheckedChanged="OnChannelChanged" />
          <CheckBox Name="GreenBox" Content="G" IsChecked="True" IsCheckedChanged="OnChannelChanged" />
          <CheckBox Name="BlueBox" Content="B" IsChecked="True" IsCheckedChanged="OnChannelChanged" />
          <CheckBox Name="AlphaBox" Content="A" IsChecked="True" IsCheckedChanged="OnChannelChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <Border Background="#FF2B2B2B">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="False">
          <Panel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
            <Image Name="PreviewImage" Stretch="Uniform" MaxWidth="2048" MaxHeight="2048" IsVisible="False" />
            <TextBox Name="DetailBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="Transparent" Foreground="#FFE8E8E8" BorderThickness="0"
                     FontFamily="Consolas,monospace" FontSize="12" IsVisible="False"
                     MinWidth="280" MinHeight="120" />
            <TextBlock Name="PlaceholderText" Text="No preview"
                       Foreground="#FF888888" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Panel>
        </ScrollViewer>
      </Border>
    </Panel>
  </DockPanel>
</UserControl>
