<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AlphaChannel.TexTools.UI.MainWindow"
        Title="AlphaChannel TexTools"
        Width="820" Height="580"
        MinWidth="640" MinHeight="440">
  <Panel Margin="24">
    <!-- Setup / path page -->
    <Grid Name="SetupPanel" RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="True">
      <TextBlock Grid.Row="0" FontSize="28" FontWeight="SemiBold" Text="AlphaChannel TexTools" />
      <TextBlock Grid.Row="1" Margin="0,8,0,16" Opacity="0.75" TextWrapping="Wrap"
                 Text="Set your FFXIV install, then continue to the workspace. Browse uses Dolphin/KDE on Linux." />

      <Border Grid.Row="2" Padding="12" Margin="0,0,0,12" Background="#18000000" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Find my FFXIV install" />
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="Pick the game root (folder that contains game/) or the sqpack/ffxiv folder." />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Grid.Column="0" Name="GamePathBox" Watermark="/path/to/game/sqpack/ffxiv" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstall" Margin="0,0,8,0" />
            <Button Grid.Column="2" Content="Save" Click="OnSavePath" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Use ~/.xlcore/ffxiv" Click="OnUseXlcore" />
            <Button Content="Read launcher.ini" Click="OnReadLauncherIni" />
          </StackPanel>
          <TextBlock Name="PathStatus" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3" Spacing="10">
        <TextBlock FontWeight="SemiBold" Text="Detected paths" />
        <TextBox Name="PathsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120" FontFamily="monospace" />
      </StackPanel>

      <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Refresh" Click="OnRefresh" />
        <Button Name="ContinueButton" Content="Continue →" Click="OnContinue" IsEnabled="False" />
      </StackPanel>
    </Grid>

    <!-- Workspace (after valid path) -->
    <Grid Name="WorkspacePanel" RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="False">
      <TextBlock Grid.Row="0" FontSize="28" FontWeight="SemiBold" Text="Workspace" />
      <TextBlock Grid.Row="1" Name="WorkspacePathLabel" Margin="0,8,0,16" Opacity="0.75" TextWrapping="Wrap" />

      <Border Grid.Row="2" Padding="12" Margin="0,0,0,12" Background="#18000000" CornerRadius="6">
        <StackPanel Spacing="10">
          <TextBlock FontWeight="SemiBold" Text="Modpack tools" />
          <TextBlock Opacity="0.75" TextWrapping="Wrap"
                     Text="Full classic TexTools UI is still Windows/Wine-only. Use these native actions for now." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Upgrade modpack…" Click="OnUpgradeModpack" />
            <Button Content="Open ModPacks folder" Click="OnOpenModPacks" />
            <Button Content="Open TexTools data" Click="OnOpenDataRoot" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Run doctor" Click="OnRunDoctor" />
            <Button Content="Change game path…" Click="OnChangePath" />
          </StackPanel>
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="3" Spacing="8">
        <TextBlock FontWeight="SemiBold" Text="Output" />
        <TextBox Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="180" FontFamily="monospace" />
      </StackPanel>

      <TextBlock Grid.Row="4" Margin="0,12,0,0" Opacity="0.65" TextWrapping="Wrap"
                 Text="CLI: ./ConsoleTools/bin/Release/net8.0/ConsoleTools /upgrade ./mod.ttmp2 ./mod-upgraded.ttmp2" />
    </Grid>
  </Panel>
</Window>
