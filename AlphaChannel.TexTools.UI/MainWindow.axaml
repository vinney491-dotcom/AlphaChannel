<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AlphaChannel.TexTools.UI"
        x:Class="AlphaChannel.TexTools.UI.MainWindow"
        Title="FFXIV TexTools"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource TtChromeBrush}"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <Panel>
    <Border Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
            Background="#99119EDA" ZIndex="100">
      <TextBlock Name="DropOverlayText" Text="Drop files here"
                 Foreground="White" FontSize="22" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- Classic TexTools dark shell -->
    <DockPanel Name="WorkspacePanel" IsVisible="False">
      <Menu DockPanel.Dock="Top" Background="{StaticResource TtMenuBrush}">
        <MenuItem Header="_Mods">
          <MenuItem Header="Import Modpack to Penumbra…" Click="OnImportPenumbra" />
          <MenuItem Header="Upgrade Modpack…" Click="OnUpgradeModpack" />
          <MenuItem Header="Resave / Convert Modpack…" Click="OnResaveModpack" />
          <Separator />
          <MenuItem Header="Batch Upgrade Folder…" Click="OnBatchUpgrade" />
          <Separator />
          <MenuItem Header="Open Penumbra Mods Folder" Click="OnOpenPenumbra" />
          <MenuItem Header="Open TexTools ModPacks Folder" Click="OnOpenModPacks" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Load Item List" Click="OnLoadItems" />
          <MenuItem Header="Focus Item Search" Click="OnFocusItemSearch" />
          <MenuItem Header="Open Display Window…" Click="OnOpenDisplayWindow" />
          <Separator />
          <MenuItem Header="Show Log" Click="OnShowLogTab" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="Tattoo / Decal Converter…" Click="OnOpenTattooConverter" />
          <MenuItem Header="Colorset Viewer…" Click="OnOpenColorset" />
          <Separator />
          <MenuItem Header="Extract File…" Click="OnExtractFile" />
          <MenuItem Header="Wrap File…" Click="OnWrapFile" />
          <MenuItem Header="Unwrap File…" Click="OnUnwrapFile" />
          <Separator />
          <MenuItem Header="Dawntrail Upgrades">
            <MenuItem Header="Upgrade Modpack…" Click="OnUpgradeModpack" />
            <MenuItem Header="Batch Upgrade Folder…" Click="OnBatchUpgrade" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Options">
          <MenuItem Header="Settings / Game Path…" Click="OnChangePath" />
          <MenuItem Header="Set Penumbra Mods Folder…" Click="OnSetPenumbraFolder" />
          <MenuItem Header="Open TexTools Data Folder" Click="OnOpenDataRoot" />
          <Separator />
          <MenuItem Header="Theme">
            <MenuItem Header="Dark" Click="OnThemeDark" />
            <MenuItem Header="Light" Click="OnThemeLight" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="Backup Index Files…" Click="OnCreateBackups" />
          <MenuItem Header="Open Backups Folder" Click="OnOpenBackups" />
          <MenuItem Header="Refresh Backup Status" Click="OnRefreshBackups" />
          <Separator />
          <MenuItem Header="Check For Problems (Doctor)" Click="OnRunDoctor" />
          <Separator />
          <MenuItem Header="About TexTools" Click="OnAbout" />
        </MenuItem>
        <MenuItem Header="Mod _Sites">
          <MenuItem Header="XIV Mod Archive" Click="OnSiteXivModArchive" />
          <MenuItem Header="Nexus Mods" Click="OnSiteNexus" />
        </MenuItem>
      </Menu>

      <!-- Top status row (SAFE / Transaction) -->
      <Border DockPanel.Dock="Top" Background="{StaticResource TtStatusBrush}"
              BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Name="BusyText" Text="Ready." VerticalAlignment="Center"
                     Foreground="{StaticResource TtMutedBrush}" FontSize="12" />
          <Border Grid.Column="1" BorderBrush="{StaticResource TtSafeBrush}" BorderThickness="1"
                  Padding="10,2" Margin="8,0" VerticalAlignment="Center">
            <TextBlock Text="SAFE" Foreground="{StaticResource TtSafeBrush}" FontWeight="SemiBold" FontSize="11" />
          </Border>
          <Border Grid.Column="2" BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="1"
                  Padding="10,2" VerticalAlignment="Center">
            <TextBlock Text="Transaction Status: Closed" Foreground="{StaticResource TtMutedBrush}" FontSize="11" />
          </Border>
        </Grid>
      </Border>

      <!-- Bottom global path strip -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource TtStatusBrush}"
              BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
        <TextBlock Name="WorkspacePathLabel" Foreground="{StaticResource TtMutedBrush}" FontSize="11" />
      </Border>

      <!-- Classic 1 : 3 — Item List | Item View -->
      <Grid Margin="5" ColumnDefinitions="*,5,3*">
        <!-- ITEM LIST -->
        <Border Classes="tt-group" Grid.Column="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ITEM LIST" Foreground="{StaticResource TtAccentBrush}"
                       FontWeight="Bold" FontSize="13" Margin="10,8,10,4" />
            <TextBox DockPanel.Dock="Top" Name="ItemSearchBox" Watermark="Search…" Margin="8,0,8,6"
                     KeyUp="OnItemSearchKeyUp" />
            <Border DockPanel.Dock="Bottom" Background="{StaticResource TtStatusBrush}"
                    BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="0,1,0,0" Padding="8,6">
              <TextBlock Name="ItemsStatusBox" Text="Click Load Item List (View menu) or press Load below."
                         Foreground="{StaticResource TtMutedBrush}" FontSize="11"
                         TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
            <Button DockPanel.Dock="Bottom" Content="Load Item List" Click="OnLoadItems"
                    Classes="accent" Margin="8,0,8,8" HorizontalAlignment="Stretch" />
            <TabControl Margin="4,0">
              <TabItem Header="By Category">
                <TreeView Name="CategoryTree" SelectionChanged="OnCategoryTreeSelected">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="local:ItemTreeNode" ItemsSource="{Binding Children}">
                      <TextBlock Text="{Binding Name}" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </TabItem>
              <TabItem Header="By Name">
                <ListBox Name="ItemsList" SelectionChanged="OnItemSelected" />
              </TabItem>
            </TabControl>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                      Background="{StaticResource TtBorderBrush}" />

        <!-- ITEM VIEW (classic right pane) -->
        <Border Classes="tt-group" Grid.Column="2">
          <DockPanel>
            <!-- Item name bar -->
            <Grid DockPanel.Dock="Top" Margin="4" ColumnDefinitions="40,*,40">
              <Button Grid.Column="0" Content="R" Click="OnRefreshItemView" ToolTip.Tip="Reload item files" />
              <TextBox Grid.Column="1" Name="ItemNameBox" IsReadOnly="True" Margin="4,0"
                       Text="No Item Selected" TextAlignment="Center" />
              <Button Grid.Column="2" Content="Pop" Click="OnOpenDisplayWindow" ToolTip.Tip="Pop out display" />
            </Grid>

            <!-- Model / Material / Texture selectors -->
            <Grid DockPanel.Dock="Top" Margin="4,0,4,4" ColumnDefinitions="36,*,*,*">
              <Button Grid.Column="0" Content="=" Click="OnShowExtraPanel"
                      ToolTip.Tip="Library / tools panel" />
              <Border Grid.Column="1" BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="1" Margin="3">
                <Grid ColumnDefinitions="40,*">
                  <Button Grid.Column="0" Content="Eye" Click="OnShowModel" ToolTip.Tip="View model" FontSize="10" Padding="2" />
                  <ComboBox Grid.Column="1" Name="ModelCombo" PlaceholderText="Model"
                            SelectionChanged="OnModelComboChanged" />
                </Grid>
              </Border>
              <Border Grid.Column="2" BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="1" Margin="3">
                <Grid ColumnDefinitions="40,*">
                  <Button Grid.Column="0" Content="Eye" Click="OnShowMaterial" ToolTip.Tip="View material" FontSize="10" Padding="2" />
                  <ComboBox Grid.Column="1" Name="MaterialCombo" PlaceholderText="Material"
                            SelectionChanged="OnMaterialComboChanged" />
                </Grid>
              </Border>
              <Border Grid.Column="3" BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="1" Margin="3">
                <Grid ColumnDefinitions="40,*">
                  <Button Grid.Column="0" Content="Eye" Click="OnShowTexture" ToolTip.Tip="View texture" FontSize="10" Padding="2" />
                  <ComboBox Grid.Column="1" Name="TextureCombo" PlaceholderText="Texture"
                            SelectionChanged="OnTextureComboChanged" />
                </Grid>
              </Border>
            </Grid>

            <!-- Bottom action bar (classic FileWrapper) -->
            <Grid DockPanel.Dock="Bottom" Margin="4" ColumnDefinitions="*,*,*,*,40">
              <Button Grid.Column="0" Content="SAVE AS" Classes="tt-action" Click="OnSaveAsCurrent" />
              <Button Grid.Column="1" Content="LOAD" Classes="tt-action" Click="OnLoadExternalToDisplay" />
              <Button Grid.Column="2" Content="ENABLE" Classes="tt-action" IsEnabled="False"
                      ToolTip.Tip="DAT enable/disable is Windows/WPF TexTools only. Use Penumbra on Linux." />
              <Button Grid.Column="3" Content="SAVE TO FFXIV" Classes="tt-action accent" Click="OnSaveToFfxiv"
                      ToolTip.Tip="On Linux: import a modpack to Penumbra, or extract the current file." />
              <Button Grid.Column="4" Content="Dir" Margin="4" Click="OnOpenModPacks"
                      ToolTip.Tip="Open ModPacks folder" FontSize="10" Padding="2" />
            </Grid>

            <!-- File path bar -->
            <Grid DockPanel.Dock="Bottom" Margin="4,0,4,0" ColumnDefinitions="40,*,40,40">
              <Button Grid.Column="0" Content="R" Click="OnRefreshItemView" />
              <TextBox Grid.Column="1" Name="FilePathBox" IsReadOnly="True" Margin="4,0"
                       Text="Loading File…" TextAlignment="Center" />
              <Button Grid.Column="2" Content="Copy" Click="OnCopySelectedFilePath" ToolTip.Tip="Copy path" FontSize="10" Padding="2" />
              <Button Grid.Column="3" Content="Pop" Click="OnOpenDisplayWindow" FontSize="10" Padding="2" />
            </Grid>

            <!-- Extra / library panel (toggle) -->
            <Border DockPanel.Dock="Right" Name="ExtraPanel" IsVisible="False" Width="320"
                    BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="1,0,0,0"
                    Background="{StaticResource TtPanelAltBrush}" Padding="8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="{StaticResource TtAccentBrush}"
                           Text="LIBRARY / TOOLS" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Bottom" Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="120" FontFamily="Consolas,monospace" FontSize="11"
                         Margin="0,8,0,0" />
                <TextBlock DockPanel.Dock="Bottom" FontWeight="SemiBold" Margin="0,8,0,4" Text="Log" />
                <ScrollViewer>
                  <StackPanel Spacing="8">
                    <TextBlock Name="LibraryInfoBox" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TtMutedBrush}" />
                    <Button Content="Import to Penumbra…" Click="OnImportPenumbra" Classes="accent" />
                    <Button Content="Set Penumbra Folder…" Click="OnSetPenumbraFolder" />
                    <TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="Penumbra mods" />
                    <TextBox Name="PenumbraSearchBox" Watermark="Filter mods…" KeyUp="OnPenumbraSearchKeyUp" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Refresh" Click="OnRefreshPenumbraLibrary" />
                      <Button Content="Open" Click="OnOpenSelectedPenumbraMod" />
                      <Button Content="Reload API" Click="OnReloadSelectedPenumbraMod" />
                    </StackPanel>
                    <ListBox Name="PenumbraModsList" MinHeight="140" MaxHeight="220" />
                    <Button Content="Tattoo / Decal Converter…" Click="OnOpenTattooConverter" />
                    <Button Content="Colorset Viewer…" Click="OnOpenColorset" />
                    <Button Content="Doctor" Click="OnRunDoctor" />
                    <Button Content="Create Index Backups…" Click="OnCreateBackups" />
                    <TextBlock Name="BackupStatusBox" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TtMutedBrush}" />
                    <TextBox Name="LibraryOutputBox" IsVisible="False" />
                    <TextBox Name="ExtractOutputBox" IsVisible="False" />
                    <TextBox Name="ExtractPathBox" IsVisible="False" />
                    <CheckBox Name="ExtractSqpackBox" IsVisible="False" />
                    <TextBox Name="RootIdBox" IsVisible="False" />
                    <TextBox Name="FfPathBox" IsVisible="False" />
                    <ListBox Name="ItemFilesList" IsVisible="False" SelectionChanged="OnItemFileSelected" />
                    <TabControl Name="MainTabs" IsVisible="False">
                      <TabItem Header="0" /><TabItem Header="1" /><TabItem Header="2" />
                      <TabItem Header="3" /><TabItem Header="4" /><TabItem Header="5" />
                    </TabControl>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>

            <!-- Viewport / display -->
            <Panel>
              <Border Background="{StaticResource TtViewportBrush}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Margin="8,6"
                             Text="TexTools model displays are only an approximation, and may not be 100% accurate to in-game visuals."
                             Foreground="{StaticResource TtMutedBrush}" FontSize="11"
                             TextAlignment="Center" TextWrapping="Wrap" />
                  <local:DisplayPanel Name="MainDisplay" />
                </DockPanel>
              </Border>
            </Panel>
          </DockPanel>
        </Border>
      </Grid>
    </DockPanel>

    <!-- First-run path setup -->
    <Grid Name="SetupPanel" IsVisible="True" Background="#CC000000">
      <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource TtPanelBrush}" BorderBrush="{StaticResource TtAccentBrush}"
              BorderThickness="1" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource TtAccentBrush}" Padding="16,10">
            <TextBlock Text="FFXIV TexTools" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          </Border>
          <StackPanel Margin="20" Spacing="10">
            <TextBlock Foreground="{StaticResource TtMutedBrush}" TextWrapping="Wrap"
                       Text="Set your FFXIV install (sqpack/ffxiv), then continue. Drop a game folder or modpack onto the window anytime." />
            <TextBlock FontWeight="SemiBold" Text="FFXIV Directory" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" Name="GamePathBox" Watermark="/path/to/game/sqpack/ffxiv" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstall" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="Save" Click="OnSavePath" Classes="accent" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Read launcher.ini" Click="OnReadLauncherIni" />
              <Button Content="Use ~/.xlcore/ffxiv" Click="OnUseXlcore" />
              <Button Content="Refresh" Click="OnRefresh" />
            </StackPanel>
            <TextBlock Name="PathStatus" TextWrapping="Wrap" Foreground="{StaticResource TtMutedBrush}" />
            <TextBox Name="PathsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="100" FontFamily="Consolas,monospace" FontSize="11" />
            <Button Name="ContinueButton" Content="Start TexTools" Click="OnContinue"
                    HorizontalAlignment="Right" Classes="accent" IsEnabled="False" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
