<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AlphaChannel.TexTools.UI"
        x:Class="AlphaChannel.TexTools.UI.MainWindow"
        Title="FFXIV TexTools"
        Width="1280" Height="720"
        MinWidth="900" MinHeight="560"
        Background="{StaticResource TtChromeBrush}"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">
  <Panel>
    <Border Name="DropOverlay" IsVisible="False" IsHitTestVisible="False"
            Background="#99119EDA" ZIndex="100">
      <TextBlock Name="DropOverlayText" Text="Drop files here"
                 Foreground="White" FontSize="22" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <!-- Classic TexTools shell: menu + Item List | detail -->
    <DockPanel Name="WorkspacePanel" IsVisible="False">
      <Menu DockPanel.Dock="Top" Background="{StaticResource TtMenuBrush}">
        <MenuItem Header="_Mods">
          <MenuItem Header="Import Modpack to Penumbra…" Click="OnImportPenumbra" />
          <MenuItem Header="Upgrade Modpack…" Click="OnUpgradeModpack" />
          <MenuItem Header="Resave / Convert Modpack…" Click="OnResaveModpack" />
          <Separator />
          <MenuItem Header="Batch Upgrade Folder…" Click="OnBatchUpgrade" />
          <Separator />
          <MenuItem Header="Open Penumbra Mods Folder" Click="OnOpenPenumbra" />
          <MenuItem Header="Open TexTools ModPacks Folder" Click="OnOpenModPacks" />
        </MenuItem>
        <MenuItem Header="_View">
          <MenuItem Header="Load Item List" Click="OnLoadItems" />
          <MenuItem Header="Focus Item Search" Click="OnFocusItemSearch" />
          <MenuItem Header="Open Display Window…" Click="OnOpenDisplayWindow" />
          <Separator />
          <MenuItem Header="Show Log Tab" Click="OnShowLogTab" />
        </MenuItem>
        <MenuItem Header="_Tools">
          <MenuItem Header="Extract File…" Click="OnExtractFile" />
          <MenuItem Header="Wrap File…" Click="OnWrapFile" />
          <MenuItem Header="Unwrap File…" Click="OnUnwrapFile" />
          <Separator />
          <MenuItem Header="Dawntrail Upgrades">
            <MenuItem Header="Upgrade Modpack…" Click="OnUpgradeModpack" />
            <MenuItem Header="Batch Upgrade Folder…" Click="OnBatchUpgrade" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Options">
          <MenuItem Header="Settings / Game Path…" Click="OnChangePath" />
          <MenuItem Header="Set Penumbra Mods Folder…" Click="OnSetPenumbraFolder" />
          <MenuItem Header="Open Penumbra Mods Folder" Click="OnOpenPenumbra" />
          <MenuItem Header="Open TexTools Data Folder" Click="OnOpenDataRoot" />
          <Separator />
          <MenuItem Header="Theme">
            <MenuItem Header="Light" Click="OnThemeLight" />
            <MenuItem Header="Dark" Click="OnThemeDark" />
          </MenuItem>
        </MenuItem>
        <MenuItem Header="_Help">
          <MenuItem Header="Backup Index Files…" Click="OnCreateBackups" />
          <MenuItem Header="Open Backups Folder" Click="OnOpenBackups" />
          <MenuItem Header="Refresh Backup Status" Click="OnRefreshBackups" />
          <Separator />
          <MenuItem Header="Check For Problems (Doctor)" Click="OnRunDoctor" />
          <Separator />
          <MenuItem Header="About TexTools" Click="OnAbout" />
        </MenuItem>
        <MenuItem Header="Mod _Sites">
          <MenuItem Header="XIV Mod Archive" Click="OnSiteXivModArchive" />
          <MenuItem Header="Nexus Mods" Click="OnSiteNexus" />
        </MenuItem>
      </Menu>

      <!-- Bottom status (classic StatusTextBox area + path) -->
      <Border DockPanel.Dock="Bottom" Background="{StaticResource TtStatusBrush}"
              BorderBrush="{StaticResource TtBorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="BusyText" Text="Ready." TextWrapping="Wrap" VerticalAlignment="Center"
                     Foreground="{StaticResource TtTextBrush}" FontSize="12" />
          <TextBlock Grid.Column="1" Name="WorkspacePathLabel" Foreground="{StaticResource TtMutedBrush}"
                     Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11" />
        </Grid>
      </Border>

      <!-- Classic 1 : 3 split -->
      <Grid Margin="5" ColumnDefinitions="*,5,3*">
        <Border Classes="tt-group" Grid.Column="0">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource TtAccentBrush}" Padding="8,4" Margin="0,0,0,-1">
              <TextBlock Text="Item List" Foreground="White" FontWeight="SemiBold" FontSize="13" />
            </Border>
            <Border DockPanel.Dock="Top" Padding="8,8,8,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Name="ItemSearchBox" Watermark="Search items…" Margin="0,0,6,0"
                         KeyUp="OnItemSearchKeyUp" />
                <Button Grid.Column="1" Content="Load" Click="OnLoadItems" Classes="accent" />
              </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="8,6" BorderBrush="{StaticResource TtBorderBrush}"
                    BorderThickness="0,1,0,0" Background="{StaticResource TtStatusBrush}">
              <TextBlock Name="ItemsStatusBox" Foreground="{StaticResource TtMutedBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" FontSize="11"
                         Text="Click Load to populate the item list." />
            </Border>
            <ListBox Name="ItemsList" Margin="8,8,8,0" SelectionChanged="OnItemSelected" />
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                      Background="{StaticResource TtBorderBrush}" />

        <Border Classes="tt-group" Grid.Column="2" Padding="0">
          <TabControl Name="MainTabs" Padding="4">
            <TabItem Header="Item Files">
              <DockPanel Margin="4">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="4,4,4,8">
                  <Button Content="Extract Selected…" Click="OnExtractSelectedItemFile" Classes="accent" />
                  <Button Content="Copy Path" Click="OnCopySelectedFilePath" />
                  <Button Content="Pop Out Display" Click="OnOpenDisplayWindow" />
                  <TextBox Name="ExtractPathBox" Width="280" Watermark="Internal path…" />
                </StackPanel>
                <Grid ColumnDefinitions="*,5,1.4*">
                  <ListBox Name="ItemFilesList" SelectionChanged="OnItemFileSelected" />
                  <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"
                                Background="{StaticResource TtBorderBrush}" />
                  <Border Grid.Column="2" Classes="tt-group">
                    <local:DisplayPanel Name="MainDisplay" />
                  </Border>
                </Grid>
              </DockPanel>
            </TabItem>

            <TabItem Header="Modpacks">
              <ScrollViewer>
                <StackPanel Margin="12" Spacing="12">
                  <TextBlock Foreground="{StaticResource TtMutedBrush}" TextWrapping="Wrap"
                             Text="Penumbra-first workflows — same jobs as Mods → Import Modpack to Penumbra on classic TexTools." />
                  <Button Content="Import Modpack to Penumbra…" Click="OnImportPenumbra" HorizontalAlignment="Left" Classes="accent" />
                  <Button Content="Upgrade Modpack…" Click="OnUpgradeModpack" HorizontalAlignment="Left" />
                  <Button Content="Resave / Convert…" Click="OnResaveModpack" HorizontalAlignment="Left" />
                  <Button Content="Batch Upgrade Folder…" Click="OnBatchUpgrade" HorizontalAlignment="Left" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Tools">
              <ScrollViewer>
                <StackPanel Margin="12" Spacing="10">
                  <TextBlock FontWeight="SemiBold" Text="Raw File Operations" />
                  <CheckBox Name="ExtractSqpackBox" Content="Keep sqpack/raw extension match" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Extract Path…" Click="OnExtractFile" />
                    <TextBox Name="RootIdBox" Width="160" Watermark="c0101h0010" />
                    <Button Content="List Root" Click="OnListRoot" />
                  </StackPanel>
                  <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Text="Wrap / Unwrap" />
                  <TextBox Name="FfPathBox" Watermark="Optional internal FFXIV path (MDLs)" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Wrap File…" Click="OnWrapFile" />
                    <Button Content="Unwrap File…" Click="OnUnwrapFile" />
                  </StackPanel>
                  <TextBox Name="ExtractOutputBox" IsReadOnly="True" AcceptsReturn="True"
                           TextWrapping="Wrap" MinHeight="140" FontFamily="Consolas,monospace" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Library">
              <StackPanel Margin="12" Spacing="10">
                <TextBlock Name="LibraryInfoBox" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Set Penumbra Folder…" Click="OnSetPenumbraFolder" Classes="accent" />
                  <Button Content="Open Penumbra" Click="OnOpenPenumbra" />
                  <Button Content="Open ModPacks" Click="OnOpenModPacks" />
                  <Button Content="Open Data" Click="OnOpenDataRoot" />
                  <Button Content="Doctor" Click="OnRunDoctor" />
                </StackPanel>
                <TextBox Name="LibraryOutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="200" FontFamily="Consolas,monospace" />
              </StackPanel>
            </TabItem>

            <TabItem Header="Help">
              <StackPanel Margin="12" Spacing="10">
                <TextBlock FontWeight="SemiBold" Text="Index Backups" />
                <TextBlock Name="BackupStatusBox" TextWrapping="Wrap" Foreground="{StaticResource TtMutedBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Create Backups…" Click="OnCreateBackups" />
                  <Button Content="Open Folder" Click="OnOpenBackups" />
                  <Button Content="Refresh" Click="OnRefreshBackups" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Display window" />
                <TextBlock Foreground="{StaticResource TtMutedBrush}" TextWrapping="Wrap"
                           Text="Texture preview + model/material info work natively. Interactive Helix 3D viewport and visual material editors remain Windows/WPF-only." />
              </StackPanel>
            </TabItem>

            <TabItem Header="Log">
              <TextBox Name="OutputBox" Margin="4" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" FontFamily="Consolas,monospace" />
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </DockPanel>

    <!-- First-run path setup (modal over chrome) -->
    <Grid Name="SetupPanel" IsVisible="True" Background="#99000000">
      <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource TtPanelBrush}" BorderBrush="{StaticResource TtAccentBrush}"
              BorderThickness="1" Padding="0" CornerRadius="2">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource TtAccentBrush}" Padding="16,10">
            <TextBlock Text="FFXIV TexTools" Foreground="White" FontSize="18" FontWeight="SemiBold" />
          </Border>
          <StackPanel Margin="20" Spacing="10">
            <TextBlock Foreground="{StaticResource TtMutedBrush}" TextWrapping="Wrap"
                       Text="AlphaChannel native Linux shell. Set your FFXIV install (sqpack/ffxiv), then continue. You can also drop the game folder or a modpack onto this window." />
            <TextBlock FontWeight="SemiBold" Text="FFXIV Directory" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" Name="GamePathBox" Watermark="/path/to/game/sqpack/ffxiv" Margin="0,0,8,0" />
              <Button Grid.Column="1" Content="Browse…" Click="OnBrowseInstall" Margin="0,0,8,0" />
              <Button Grid.Column="2" Content="Save" Click="OnSavePath" Classes="accent" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Read launcher.ini" Click="OnReadLauncherIni" />
              <Button Content="Use ~/.xlcore/ffxiv" Click="OnUseXlcore" />
              <Button Content="Refresh" Click="OnRefresh" />
            </StackPanel>
            <TextBlock Name="PathStatus" TextWrapping="Wrap" Foreground="{StaticResource TtMutedBrush}" />
            <TextBox Name="PathsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="100" FontFamily="Consolas,monospace" FontSize="11" />
            <Button Name="ContinueButton" Content="Start TexTools" Click="OnContinue"
                    HorizontalAlignment="Right" Classes="accent" IsEnabled="False" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
