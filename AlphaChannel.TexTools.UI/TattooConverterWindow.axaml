<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AlphaChannel.TexTools.UI.TattooConverterWindow"
        Title="Tattoo / Decal Converter"
        Width="640" Height="520"
        MinWidth="480" MinHeight="400"
        Background="{StaticResource TtChromeBrush}"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Convert → Penumbra" Classes="accent" Click="OnConvert" Name="ConvertButton" />
      <Button Content="Close" Click="OnClose" />
    </StackPanel>
    <StackPanel Spacing="10">
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TtMutedBrush}"
                 Text="Convert an image to a face-paint or equipment-decal texture and write a Penumbra mod folder. No mesh remapping — texture path only." />
      <TextBlock FontWeight="SemiBold" Text="Image" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Name="ImagePathBox" IsReadOnly="True" Watermark="PNG / TGA / DDS / BMP…" />
        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseImage" />
      </Grid>
      <TextBlock FontWeight="SemiBold" Text="Decal type" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <RadioButton Name="FacePaintRadio" Content="Face paint" IsChecked="True" Checked="OnTypeChanged" />
        <RadioButton Name="EquipDecalRadio" Content="Equipment decal" Checked="OnTypeChanged" />
      </StackPanel>
      <TextBlock FontWeight="SemiBold" Text="Target game path" />
      <ComboBox Name="PathCombo" MinHeight="32" HorizontalAlignment="Stretch" />
      <Button Content="Refresh slot list" Click="OnRefreshSlots" HorizontalAlignment="Left" />
      <TextBlock FontWeight="SemiBold" Text="Mod name" />
      <TextBox Name="ModNameBox" Watermark="My Decal" />
      <TextBox Name="StatusBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
               MinHeight="120" FontFamily="Consolas,monospace" FontSize="11" />
    </StackPanel>
  </DockPanel>
</Window>
